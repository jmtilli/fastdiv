@subfile
@strict

# You can modify these
$SRC_LIB = ["fastdivlib.c"]
$SRC_PROG = []
$LIB = "libfastdiv.a"
$EXTRACFLAGS = []
$CFLAGS = [@$CFLAGS, @$EXTRACFLAGS]
$LIBS = []
$UNITDEPS = []
$UNITCMDS = []

$LDFLAGS_DYN = []

# You won't want to modify anything below this line
@call $MODULE($LIB, $SRC_LIB, $SRC_PROG, $LIBS, $UNITDEPS, $UNITCMDS)

@deponly: 'all': 'libfastdiv.so' 'libfastdiv.so.1'

'libfastdiv.so.1': $LIB
@	[$(CC), "-shared", "-fPIC", "-Wl,-soname,".$@, "-o", $@, "-Wl,--whole-archive", @@suffilter($^, ".a"), "-Wl,--no-whole-archive", @$(LDFLAGS_DYN), "-lc"]

'libfastdiv.so': 'libfastdiv.so.1'
@	["rm", "-f", $@]
@	["ln", "-s", $<, $@]

@cdepincludes @autophony @autotarget @ignore \
  @sufsuball([@$SRC_PROG, @$SRC_LIB], ".c", ".d")
